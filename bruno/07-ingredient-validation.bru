meta {
  name: 07 - Admin POST Ingredient Missing Name (Validation Error)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/ingredients
  body: json
  auth: none
}

body:json {
  {
    "code": "ING_INVALID",
    "name": ""
  }
}

tests {
  test("Missing ingredient name returns ok: false and VALIDATION_FAILED", function() {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.ok).to.equal(false);
    expect(body.error.code).to.equal("VALIDATION_FAILED");
    expect(Boolean(body.error.fields.name)).to.equal(true);
  });
}
