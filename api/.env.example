# Port ứng dụng Express
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# 1. Kết nối qua Connection Pooler (Dùng cho ứng dụng Express chạy thường ngày)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Kết nối Trực tiếp (Direct connection)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage Configuration (Để lưu trữ ảnh món ăn và đầu bếp)
SUPABASE_URL="https://your_project_ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_BUCKET="restaurant-images"
